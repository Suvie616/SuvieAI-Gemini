{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SuuvieAI: Run Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "SuuvieAI: Run + Open Browser",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "python": "${command:python.interpreterPath}",
      "serverReadyAction": {
        "pattern": "URL\\s+:\\s+https?://[\\w.:]+",
        "uriFormat": "http://localhost:5000",
        "action": "openExternally"
      }
    }
  ]
}
